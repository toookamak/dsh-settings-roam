{
  "name": "@toookamak/dsh-settings-roam",
  "description": "设置漫游：把 DSH 的可移植配置推送到云端，在新机器上拉取并应用",
  "version": "0.2.7",
  "type": "module",
  "main": "index.js",
  "bin": {
    "dsh-settings-roam": "./bin/roam.js"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "src",
    "bin",
    "locale"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "test": "node --test"
  },
  "dependencies": {
    "js-yaml": "^4.3.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/cordis-plugin-include": "^1.0.10-alpha.1",
    "react": "^18.3.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-include": "^1.0.10-alpha.1",
    "@deepseek-ai/dsh-app-boot": "^0.2.1-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.5-alpha.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/cordis-plugin-include": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
